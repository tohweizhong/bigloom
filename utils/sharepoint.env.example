# SharePoint / Microsoft Graph Upload Settings Template
# Copy this file to sharepoint.env (or .env) and run: chmod 600 sharepoint.env

SP_SITE_URL=https://yourtenant.sharepoint.com/sites/YourSiteName
SP_LIBRARY=Documents
SP_TARGET_FOLDER=BigLoom-Eval
SP_CONFLICT=replace

# Azure Entra ID App Registration (Client Credentials)
SP_TENANT_ID=00000000-0000-0000-0000-000000000000
SP_CLIENT_ID=00000000-0000-0000-0000-000000000000
SP_CLIENT_SECRET=replace-with-client-secret

# Optional local source folder default
SOURCE_DIR=runs/trial-5mb
